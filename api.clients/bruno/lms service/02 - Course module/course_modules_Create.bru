meta {
  name: Create Course module
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/course-modules
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "CourseId": "{{COURSE_ID}}",
    "Name": "Jeff Rogahn122",
  //   "Description": "aliquid ab",
    "ImageUrl": "https://rahul.org",
    "DurationInMins": 7379
  }
}

tests {
    try {
        var respData = res.getBody();
        bru.setEnvVar('COURSE_MODULE_ID', respData.Data.id);
    }
    catch (error) {
        console.log(error.message);
    }
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(201);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Course modules created successfully', function () {
        var jsonRes = res.getBody();
  
        expect(jsonRes.Data).to.have.property('id');
        
        expect(jsonRes.Data).to.have.property('CourseId');
        expect(jsonRes.Data).to.have.property('Name');
        expect(jsonRes.Data).to.have.property('Description');
        expect(jsonRes.Data).to.have.property('ImageUrl');
        expect(jsonRes.Data).to.have.property('DurationInMins');
        expect(jsonRes.Data).to.have.property('ContentSequence');
        expect(jsonRes.Data).to.have.property('CreatedAt');
        expect(jsonRes.Data).to.have.property('UpdatedAt');
  
        expect(jsonRes.Data.CourseId).equals('{{COURSE_ID}}');
        expect(jsonRes.Data.Name).equals("Jeff Rogahn");
        expect(jsonRes.Data.Description).equals("aliquid ab");
        expect(jsonRes.Data.ImageUrl).equals("https://rahul.org");
        expect(jsonRes.Data.DurationInMins).equals(7379);
        expect(jsonRes.Data.ContentSequence).to.be.an('object');
  
    });
    
}
