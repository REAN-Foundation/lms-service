meta {
  name: Search course_contents
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/course-contents/search?courseId={{COURSE_ID}}
  body: json
  auth: none
}

params:query {
  courseId: {{COURSE_ID}}
  ~title: Aut perferendis et.
  ~contentType: Assessment
  ~learningPathId: {{LEARNING_PATH_ID}}
  ~courseModuleId: {{COURSE_MODULE_ID}}
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Course contents records retrieved successfully', function () {
         var jsonRes = res.getBody();
          expect(jsonRes.Data).to.have.property('Items');
          expect(jsonRes.Data.Items.length).to.be.at.least(0);
    });
    
}
