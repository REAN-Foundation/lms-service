
meta {
  name: Search course_contents
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/course-contents/search?title=Commodi voluptas ipsa.&description=Et itaque omnis.&imageUrl=Maiores ullam excepturi.&durationInMins=6287&contentType=ex&resourceLink=Voluptas expedita voluptas.&actionTemplateId=9d5461ec-87aa-78f4-5dba-21e6edd82e99&sequence=6421
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Course contents records retrieved successfully', function () {
         var jsonRes = res.getBody();
          expect(jsonRes.Data).to.have.property('Items');
          expect(jsonRes.Data.Items.length).to.be.at.least(0);
    });
    
}
