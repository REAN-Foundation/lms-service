
meta {
  name: Search Learning path courses
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/learning-path-courses/search?courseId=1b51532e-5482-409e-a168-2215e90cff77&learningPathId=55549f52-c609-68bb-70f3-dedcfede1d57
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Learning path courses records retrieved successfully', function () {
         var jsonRes = res.getBody();
          expect(jsonRes.Data).to.have.property('Items');
          expect(jsonRes.Data.Items.length).to.be.at.least(0);
    });
    
}
