meta {
  name: Add Course to Learning Path
  type: http
  seq: 6
}

post {
  url: {{BASE_URL}}/learning-paths/{{LEARNING_PATH_ID}}/courses/{{COURSE_ID}}
  body: none
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {
    test('Request is successful', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Course added to learning path successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('id');
        expect(jsonRes.Data).to.have.property('Courses');
        expect(jsonRes.Data.Courses).to.be.an('array');
    });

    test('Learning path contains the added course', function () {
        var jsonRes = res.getBody();
        var courses = jsonRes.Data.Courses || [];
        var courseIds = courses.map(c => c.id);
        expect(courseIds).to.include('{{COURSE_ID}}');
    });
}

