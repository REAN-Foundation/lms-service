meta {
  name: Reorder Courses in Learning Path
  type: http
  seq: 8
}

put {
  url: {{BASE_URL}}/learning-paths/{{LEARNING_PATH_ID}}/reorder-courses
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "CourseSequence": {
      "313c60c4-efbf-47ec-9b2f-82ac89bb4289": 1,
      "5b99902d-0188-4f79-84fa-f3dbd29f2b76": 2,
      "69ac399b-2e58-469e-9519-81fc1575c430": 3,
      "79273545-9899-4620-92f0-b26d534f6203": 4,
      "86ba5e87-1abb-42af-ba02-c5923084a42d": 5
    }
  }
}

tests {
    test('Request is successful', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Courses reordered successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.be.an('object');
        expect(jsonRes.Data).to.have.property('id');
        expect(jsonRes.Data).to.have.property('Courses');
        expect(jsonRes.Data.Courses).to.be.an('array');
    });
  
    test('Courses are in the correct order', function () {
        var jsonRes = res.getBody();
        var courses = jsonRes.Data.Courses || [];
        var courseIds = courses.map(c => c.id);
        var expectedOrder = ['{{COURSE_ID}}', '{{COURSE_ID_2}}'];
        // Verify that courses appear in the expected order (if both are provided)
        if (expectedOrder[0] && expectedOrder[1]) {
            var index1 = courseIds.indexOf(expectedOrder[0]);
            var index2 = courseIds.indexOf(expectedOrder[1]);
            expect(index1).to.be.lessThan(index2);
        }
    });
}
