
meta {
  name: Update Learning path
  type: http
  seq: 4
}

put {
  url: {{BASE_URL}}/learning-paths/{{LEARNING_PATH_ID}}
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
{
    "TenantId": "{{TENANT_ID}}",
    "Name": "Frances Lebsack",
    "Description": "esse qui",
    "ImageUrl": "http://aditya.com",
    "DurationInDays": 8898,
    "PreferenceWeight": 8592,
    "Enabled": true,
    "CourseSequence": {
      "{{COURSE_ID}}": 1
    }
  }
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Learning paths updated successfully', function () {
        var jsonRes = res.getBody();

        expect(jsonRes.Data).to.have.property('id');
        
        expect(jsonRes.Data).to.have.property('TenantId');
        expect(jsonRes.Data).to.have.property('Name');
        expect(jsonRes.Data).to.have.property('Description');
        expect(jsonRes.Data).to.have.property('ImageUrl');
        expect(jsonRes.Data).to.have.property('DurationInDays');
        expect(jsonRes.Data).to.have.property('PreferenceWeight');
        expect(jsonRes.Data).to.have.property('Enabled');

        expect(jsonRes.Data.Name).equals("Frances Lebsack");
        expect(jsonRes.Data.Description).equals("esse qui");
        expect(jsonRes.Data.ImageUrl).equals("http://aditya.com");
        expect(jsonRes.Data.DurationInDays).equals(8898);
        expect(jsonRes.Data.PreferenceWeight).equals(8592);
        expect(jsonRes.Data.Enabled).equals(true);

    });
    
}
