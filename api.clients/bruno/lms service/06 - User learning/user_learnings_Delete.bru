
meta {
  name: Delete User learning
  type: http
  seq: 5
}

delete {
  url: {{BASE_URL}}/user-learnings/{{USER_LEARNING_ID}}
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

     test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('User learnings deleted successfully', function () {
        let expectedValue = true;
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('deleted');
        expect(jsonRes.Data.deleted).to.equal(true);
    });
    
}
