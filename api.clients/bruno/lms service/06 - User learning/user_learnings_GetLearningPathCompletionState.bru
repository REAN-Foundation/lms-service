
meta {
  name: Get Learning Path Completion State
  type: http
  seq: 13
}

get {
  url: {{BASE_URL}}/user-learnings/{{USER_ID}}/learning-paths/{{LEARNING_PATH_ID}}/completion-state
  body: none
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Learning path completion state retrieved successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.be.an('object');
    });
    
}

