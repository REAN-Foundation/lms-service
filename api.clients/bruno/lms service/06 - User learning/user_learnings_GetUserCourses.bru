
meta {
  name: Get User courses
  type: http
  seq: 8
}

get {
  url: {{BASE_URL}}/user-learnings/{{USER_ID}}/courses
  body: none
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('User courses retrieved successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.be.an('array');
    });
    
}

