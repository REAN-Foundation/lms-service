
meta {
  name: Read User learning
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/user-learnings/{{USER_LEARNING_ID}}
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('User learnings retrieved successfully', function () {
        var jsonRes = res.getBody();
        
        expect(jsonRes.Data).to.have.property('CourseId');
        expect(jsonRes.Data).to.have.property('LearningPathId');
        expect(jsonRes.Data).to.have.property('CourseModuleId');
        expect(jsonRes.Data).to.have.property('CourseContentId');
        expect(jsonRes.Data).to.have.property('UserId');
        expect(jsonRes.Data).to.have.property('ActionId');
        expect(jsonRes.Data).to.have.property('ProgressStatus');
        expect(jsonRes.Data).to.have.property('PercentageCompletion');


    });
    
}
