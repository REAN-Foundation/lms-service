meta {
  name: Update User learning
  type: http
  seq: 4
}

put {
  url: {{BASE_URL}}/user-learnings/{{USER_LEARNING_ID}}
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "CourseId": "{{COURSE_ID}}",
    "LearningPathId": "{{LEARNING_PATH_ID}}",
    "CourseModuleId": "{{COURSE_MODULE_ID}}",
    "CourseContentId": "{{COURSE_CONTENT_ID}}",
    "UserId": "{{USER_ID}}",
    "ProgressStatus": "Delayed"
  }
}

tests {
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('User learnings updated successfully', function () {
        var jsonRes = res.getBody();
  
        expect(jsonRes.Data).to.have.property('id');
        
        expect(jsonRes.Data).to.have.property('CourseId');
        expect(jsonRes.Data).to.have.property('LearningPathId');
        expect(jsonRes.Data).to.have.property('CourseModuleId');
        expect(jsonRes.Data).to.have.property('CourseContentId');
        expect(jsonRes.Data).to.have.property('UserId');
        expect(jsonRes.Data).to.have.property('ActionId');
        expect(jsonRes.Data).to.have.property('ProgressStatus');
        expect(jsonRes.Data).to.have.property('PercentageCompletion');
  
        expect(jsonRes.Data.CourseId).equals('{{COURSE_ID}}');
        expect(jsonRes.Data.LearningPathId).equals('{{LEARNING_PATH_ID}}');
        expect(jsonRes.Data.CourseModuleId).equals('{{COURSE_MODULE_ID}}');
        expect(jsonRes.Data.CourseContentId).equals('{{COURSE_CONTENT_ID}}');
        expect(jsonRes.Data.ProgressStatus).equals("Delayed");
        expect(jsonRes.Data.PercentageCompletion).equals(7424);
  
    });
    
}
