meta {
  name: Update User learning for content
  type: http
  seq: 6
}

put {
  url: {{BASE_URL}}/user-learnings/{{USER_ID}}/contents/{{COURSE_CONTENT_ID}}
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "ProgressStatus": "Completed"
  }
}

tests {
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('User learning updated successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('id');
        expect(jsonRes.Data).to.have.property('ProgressStatus');
        expect(jsonRes.Data).to.have.property('PercentageCompletion');
    });
    
}
