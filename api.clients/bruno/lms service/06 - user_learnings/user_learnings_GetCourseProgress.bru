
meta {
  name: Get Course Progress
  type: http
  seq: 10
}

get {
  url: {{BASE_URL}}/user-learnings/{{USER_ID}}/courses/{{COURSE_ID}}/progress
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Course progress retrieved successfully', function () {
        var jsonRes = res.getBody();
        
        expect(jsonRes.Data).to.have.property('CourseProgress');
        expect(jsonRes.Data.CourseProgress).to.be.a('number');
        expect(jsonRes.Data.CourseProgress).to.be.at.least(0);
        expect(jsonRes.Data.CourseProgress).to.be.at.most(1);

    });
    
}

