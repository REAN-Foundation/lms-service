
meta {
  name: Get User Learning Paths
  type: http
  seq: 7
}

get {
  url: {{BASE_URL}}/user-learnings/{{USER_ID}}/learning-paths
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('User learning paths retrieved successfully', function () {
        var jsonRes = res.getBody();
        
        expect(jsonRes.Data).to.have.property('UserLearningPaths');
        expect(jsonRes.Data.UserLearningPaths).to.be.an('array');
        
        if (jsonRes.Data.UserLearningPaths.length > 0) {
            var path = jsonRes.Data.UserLearningPaths[0];
            expect(path).to.have.property('id');
            expect(path).to.have.property('Name');
            expect(path).to.have.property('PercentageCompletion');
        }

    });
    
}


