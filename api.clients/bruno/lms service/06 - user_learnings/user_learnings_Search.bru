
meta {
  name: Search user_learnings
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/user-learnings/search?userId=e8d422d6-3cf2-fd41-9384-370d082d9fbe&actionId=7e8c8bb0-7e12-1f87-bf41-5433dd3a8bb4&progressStatus=vero&percentageCompletion=2121
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('User learnings records retrieved successfully', function () {
         var jsonRes = res.getBody();
          expect(jsonRes.Data).to.have.property('Items');
          expect(jsonRes.Data.Items.length).to.be.at.least(0);
    });
    
}
