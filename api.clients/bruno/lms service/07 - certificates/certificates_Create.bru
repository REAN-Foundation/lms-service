
meta {
  name: Create Certificates
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/certificates
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
{
    "CourseId": "{{COURSE_ID}}",
    "UserId": "{{USER_ID}}",
    "CertificateNumber": "Explicabo et maxime.",
    "CertificateName": "Malcolm Padberg",
    "CertificateType": "Dolor dolores fugiat.",
    "IssuedDate": "Esse excepturi sequi.",
    "ExpiryDate": "2025-07-01T19:02:05",
    "CertificateUrl": "https://layla.name",
    "FinalGrade": 8504.074,
    "CreditHours": 2137,
    "Skills": "Est quidem cum.",
    "IsVerified": true,
    "VerificationUrl": "https://gerson.net",
    "IssuedBy": "945b0e7c-7c31-5e6f-120d-b11824c1b8aa"
  }
}

tests {

    try {
        var respData = res.getBody();
        bru.setEnvVar('CERTIFICATES_ID', respData.Data.id);
    }
    catch (error) {
        console.log(error.message);
    }
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(201);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Certificates created successfully', function () {
        var jsonRes = res.getBody();

        expect(jsonRes.Data).to.have.property('id');
        
        expect(jsonRes.Data).to.have.property('CourseId');
        expect(jsonRes.Data).to.have.property('UserId');
        expect(jsonRes.Data).to.have.property('CertificateNumber');
        expect(jsonRes.Data).to.have.property('CertificateName');
        expect(jsonRes.Data).to.have.property('CertificateType');
        expect(jsonRes.Data).to.have.property('IssuedDate');
        expect(jsonRes.Data).to.have.property('ExpiryDate');
        expect(jsonRes.Data).to.have.property('CertificateUrl');
        expect(jsonRes.Data).to.have.property('FinalGrade');
        expect(jsonRes.Data).to.have.property('CreditHours');
        expect(jsonRes.Data).to.have.property('Skills');
        expect(jsonRes.Data).to.have.property('IsVerified');
        expect(jsonRes.Data).to.have.property('VerificationUrl');
        expect(jsonRes.Data).to.have.property('IssuedBy');

        expect(jsonRes.Data.CourseId).equals('{{COURSE_ID}}');
        expect(jsonRes.Data.CertificateNumber).equals("Explicabo et maxime.");
        expect(jsonRes.Data.CertificateName).equals("Malcolm Padberg");
        expect(jsonRes.Data.CertificateType).equals("Dolor dolores fugiat.");
        expect(jsonRes.Data.IssuedDate).equals("Esse excepturi sequi.");
        expect(jsonRes.Data.ExpiryDate).equals("2025-07-01T19:02:05");
        expect(jsonRes.Data.CertificateUrl).equals("https://layla.name");
        expect(jsonRes.Data.FinalGrade).equals(8504.074);
        expect(jsonRes.Data.CreditHours).equals(2137);
        expect(jsonRes.Data.Skills).equals("Est quidem cum.");
        expect(jsonRes.Data.IsVerified).equals(true);
        expect(jsonRes.Data.VerificationUrl).equals("https://gerson.net");
        expect(jsonRes.Data.IssuedBy).equals("945b0e7c-7c31-5e6f-120d-b11824c1b8aa");

    });
    
}
