
meta {
  name: Download Learning Path Certificates
  type: http
  seq: 7
}

get {
  url: {{BASE_URL}}/certificates/learning-paths/{{LEARNING_PATH_ID}}/download
  body: none
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Learning path certificates retrieved successfully', function () {
        var jsonRes = res.getBody();
        
        expect(jsonRes.Data).to.have.property('Certificates');
        expect(jsonRes.Data.Certificates).to.be.an('array');
        
        if (jsonRes.Data.Certificates.length > 0) {
            expect(jsonRes.Data.Certificates[0]).to.have.property('CourseId');
            expect(jsonRes.Data.Certificates[0]).to.have.property('UserId');
            expect(jsonRes.Data.Certificates[0]).to.have.property('CertificateUrl');
        }
    });
    
}
