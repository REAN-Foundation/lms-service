
meta {
  name: Put certificates
  type: http
  seq: 4
}

put {
  url: {{BASE_URL}}/certificates/{{CERTIFICATES_ID}}
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
{
    "CourseId": "{{COURSE_ID}}",
    "UserId": "{{USER_ID}}",
    "CertificateNumber": "Molestiae aut est.",
    "CertificateName": "Lester Rowe",
    "CertificateType": "Laboriosam dolore expedita.",
    "IssuedDate": "Porro blanditiis quos.",
    "ExpiryDate": "2025-02-12T00:35:41",
    "CertificateUrl": "http://marcel.org",
    "FinalGrade": 848.7727,
    "CreditHours": 9028,
    "Skills": "Amet eligendi neque.",
    "IsVerified": true,
    "VerificationUrl": "https://walter.name",
    "IssuedBy": "8871d0af-e2c2-6aad-3906-16eb6ddc707e"
  }
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Certificates updated successfully', function () {
        var jsonRes = res.getBody();

        expect(jsonRes.Data).to.have.property('id');
        
        expect(jsonRes.Data).to.have.property('CourseId');
        expect(jsonRes.Data).to.have.property('UserId');
        expect(jsonRes.Data).to.have.property('CertificateNumber');
        expect(jsonRes.Data).to.have.property('CertificateName');
        expect(jsonRes.Data).to.have.property('CertificateType');
        expect(jsonRes.Data).to.have.property('IssuedDate');
        expect(jsonRes.Data).to.have.property('ExpiryDate');
        expect(jsonRes.Data).to.have.property('CertificateUrl');
        expect(jsonRes.Data).to.have.property('FinalGrade');
        expect(jsonRes.Data).to.have.property('CreditHours');
        expect(jsonRes.Data).to.have.property('Skills');
        expect(jsonRes.Data).to.have.property('IsVerified');
        expect(jsonRes.Data).to.have.property('VerificationUrl');
        expect(jsonRes.Data).to.have.property('IssuedBy');

        expect(jsonRes.Data.CourseId).equals('{{COURSE_ID}}');
        expect(jsonRes.Data.CertificateNumber).equals("Molestiae aut est.");
        expect(jsonRes.Data.CertificateName).equals("Lester Rowe");
        expect(jsonRes.Data.CertificateType).equals("Laboriosam dolore expedita.");
        expect(jsonRes.Data.IssuedDate).equals("Porro blanditiis quos.");
        expect(jsonRes.Data.ExpiryDate).equals("2025-02-12T00:35:41");
        expect(jsonRes.Data.CertificateUrl).equals("http://marcel.org");
        expect(jsonRes.Data.FinalGrade).equals(848.7727);
        expect(jsonRes.Data.CreditHours).equals(9028);
        expect(jsonRes.Data.Skills).equals("Amet eligendi neque.");
        expect(jsonRes.Data.IsVerified).equals(true);
        expect(jsonRes.Data.VerificationUrl).equals("https://walter.name");
        expect(jsonRes.Data.IssuedBy).equals("8871d0af-e2c2-6aad-3906-16eb6ddc707e");

    });
    
}
