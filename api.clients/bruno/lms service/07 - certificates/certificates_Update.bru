
meta {
  name: Update Certificates
  type: http
  seq: 4
}

put {
  url: {{BASE_URL}}/certificates/{{CERTIFICATES_ID}}
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
{
    "CourseId": "{{COURSE_ID}}",
    "UserId": "{{USER_ID}}",
    "CertificateNumber": "Ad qui quibusdam.",
    "CertificateName": "Hannah Volkman",
    "CertificateType": "Facilis cumque earum.",
    "IssuedDate": "Rem voluptas et.",
    "ExpiryDate": "2025-04-01T03:18:37",
    "CertificateUrl": "https://rahsaan.com",
    "FinalGrade": 9122.092,
    "CreditHours": 1710,
    "Skills": "Totam hic cumque.",
    "IsVerified": false,
    "VerificationUrl": "http://joy.com",
    "IssuedBy": "e3bcbb45-b1e8-bf85-65f2-f2ba7d6015ca"
  }
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Certificates updated successfully', function () {
        var jsonRes = res.getBody();

        expect(jsonRes.Data).to.have.property('id');
        
        expect(jsonRes.Data).to.have.property('CourseId');
        expect(jsonRes.Data).to.have.property('UserId');
        expect(jsonRes.Data).to.have.property('CertificateNumber');
        expect(jsonRes.Data).to.have.property('CertificateName');
        expect(jsonRes.Data).to.have.property('CertificateType');
        expect(jsonRes.Data).to.have.property('IssuedDate');
        expect(jsonRes.Data).to.have.property('ExpiryDate');
        expect(jsonRes.Data).to.have.property('CertificateUrl');
        expect(jsonRes.Data).to.have.property('FinalGrade');
        expect(jsonRes.Data).to.have.property('CreditHours');
        expect(jsonRes.Data).to.have.property('Skills');
        expect(jsonRes.Data).to.have.property('IsVerified');
        expect(jsonRes.Data).to.have.property('VerificationUrl');
        expect(jsonRes.Data).to.have.property('IssuedBy');

        expect(jsonRes.Data.CourseId).equals('{{COURSE_ID}}');
        expect(jsonRes.Data.CertificateNumber).equals("Ad qui quibusdam.");
        expect(jsonRes.Data.CertificateName).equals("Hannah Volkman");
        expect(jsonRes.Data.CertificateType).equals("Facilis cumque earum.");
        expect(jsonRes.Data.IssuedDate).equals("Rem voluptas et.");
        expect(jsonRes.Data.ExpiryDate).equals("2025-04-01T03:18:37");
        expect(jsonRes.Data.CertificateUrl).equals("https://rahsaan.com");
        expect(jsonRes.Data.FinalGrade).equals(9122.092);
        expect(jsonRes.Data.CreditHours).equals(1710);
        expect(jsonRes.Data.Skills).equals("Totam hic cumque.");
        expect(jsonRes.Data.IsVerified).equals(false);
        expect(jsonRes.Data.VerificationUrl).equals("http://joy.com");
        expect(jsonRes.Data.IssuedBy).equals("e3bcbb45-b1e8-bf85-65f2-f2ba7d6015ca");

    });
    
}
