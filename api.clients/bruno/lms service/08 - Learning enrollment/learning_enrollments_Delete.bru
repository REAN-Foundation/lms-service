meta {
  name: Delete Learning enrollment
  type: http
  seq: 7
}

delete {
  url: {{BASE_URL}}/learning-enrollments/{{LEARNING_ENROLLMENT_ID}}
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successful', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Learning enrollment deleted', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('deleted');
    });
}

