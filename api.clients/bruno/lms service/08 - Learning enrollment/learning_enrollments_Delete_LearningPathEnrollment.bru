meta {
  name: Delete Learning Path Enrollment
  type: http
  seq: 17
}

delete {
  url: {{BASE_URL}}/enrollments/{{LEARNING_PATH_ENROLLMENT_ID}}
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successful', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Learning path enrollment deleted successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('Deleted');
        expect(jsonRes.Data.Deleted).to.be.true;
    });
}

