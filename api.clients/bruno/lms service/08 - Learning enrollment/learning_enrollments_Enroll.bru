meta {
  name: Enroll Learning enrollment
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/learning-enrollments/users/{{USER_ID}}/enroll
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "CourseId": "{{COURSE_ID}}",
    "TenantId": "{{TENANT_ID}}",
    "StartDate": "2025-01-01T00:00:00.000Z",
    "ProgressStatus": "InProgress"
  }
}

tests {
    try {
        var respData = res.getBody();
        if (respData.Data && respData.Data.id) {
            bru.setEnvVar('LEARNING_ENROLLMENT_ID', respData.Data.id);
        }
    }
    catch (error) {
        console.log(error.message);
    }

    test('Request is successful', function () {
        expect(res.getStatus()).to.equal(201);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Learning enrollment created successfully', function () {
        var jsonRes = res.getBody();

        expect(jsonRes.Data).to.have.property('UserId');
        expect(jsonRes.Data).to.have.property('CourseId');
        expect(jsonRes.Data).to.have.property('ProgressStatus');
        expect(jsonRes.Data).to.have.property('IsActive');

        expect(jsonRes.Data.CourseId).equals('{{COURSE_ID}}');
        expect(jsonRes.Data.UserId).equals('{{USER_ID}}');
        expect(jsonRes.Data.IsActive).to.be.true;
    });
}

