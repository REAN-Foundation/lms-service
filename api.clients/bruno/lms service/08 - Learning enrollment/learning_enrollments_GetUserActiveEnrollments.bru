meta {
  name: Get User Active Enrollments
  type: http
  seq: 4
}

get {
  url: {{BASE_URL}}/enrollments/users/{{USER_ID}}/active
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successful', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Active enrollments retrieved with both course and learning path enrollments', function () {
        var jsonRes = res.getBody();
        
        expect(jsonRes.Data).to.have.property('CourseEnrollments');
        expect(jsonRes.Data).to.have.property('LearningPathEnrollments');
        expect(jsonRes.Data.CourseEnrollments).to.be.an('array');
        expect(jsonRes.Data.LearningPathEnrollments).to.be.an('array');
    });

    test('All returned enrollments are active', function () {
        var jsonRes = res.getBody();
        
        jsonRes.Data.CourseEnrollments.forEach(function(enrollment) {
            expect(enrollment.IsActive).to.be.true;
        });
        
        jsonRes.Data.LearningPathEnrollments.forEach(function(enrollment) {
            expect(enrollment.IsActive).to.be.true;
        });
    });
}

