meta {
  name: Get User Active Learning enrollments
  type: http
  seq: 5
}

get {
  url: {{BASE_URL}}/learning-enrollments/users/{{USER_ID}}/active-enrollments
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successful', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Active enrollments retrieved', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('Enrollments');
    });
}

