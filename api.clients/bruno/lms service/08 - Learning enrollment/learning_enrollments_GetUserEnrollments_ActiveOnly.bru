meta {
  name: Get User Enrollments - Active Only
  type: http
  seq: 14
}

get {
  url: {{BASE_URL}}/enrollments/users/{{USER_ID}}?includeInactive=false
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successful', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Only active enrollments are returned', function () {
        var jsonRes = res.getBody();

        expect(jsonRes.Data).to.have.property('CourseEnrollments');
        expect(jsonRes.Data).to.have.property('LearningPathEnrollments');
        
        jsonRes.Data.CourseEnrollments.forEach(function(enrollment) {
            expect(enrollment.IsActive).to.be.true;
        });
        
        jsonRes.Data.LearningPathEnrollments.forEach(function(enrollment) {
            expect(enrollment.IsActive).to.be.true;
        });
    });
}

