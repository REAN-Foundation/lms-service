meta {
  name: Get Enrollment by ID
  type: http
  seq: 5
}

get {
  url: {{BASE_URL}}/enrollments/{{COURSE_ENROLLMENT_ID}}
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successful', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Enrollment retrieved with all required fields', function () {
        var jsonRes = res.getBody();

        expect(jsonRes.Data).to.have.property('id');
        expect(jsonRes.Data).to.have.property('UserId');
        expect(jsonRes.Data).to.have.property('IsActive');
        expect(jsonRes.Data).to.have.property('StartDate');
        expect(jsonRes.Data).to.have.property('ExpectedEndDate');
        expect(jsonRes.Data).to.have.property('EnrolledAt');
        expect(jsonRes.Data).to.have.property('CreatedAt');
        expect(jsonRes.Data).to.have.property('UpdatedAt');
    });

    test('Enrollment has either CourseId or LearningPathId', function () {
        var jsonRes = res.getBody();
        
        var hasCourseId = jsonRes.Data.hasOwnProperty('CourseId') && jsonRes.Data.CourseId !== null;
        var hasLearningPathId = jsonRes.Data.hasOwnProperty('LearningPathId') && jsonRes.Data.LearningPathId !== null;
        
        expect(hasCourseId || hasLearningPathId).to.be.true;
    });
}

