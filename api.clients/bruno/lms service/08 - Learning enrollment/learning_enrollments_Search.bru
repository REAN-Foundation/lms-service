meta {
  name: Search Enrollments
  type: http
  seq: 6
}

get {
  url: {{BASE_URL}}/enrollments/search
  body: json
  auth: none
}

params:query {
  ~pageIndex: 0
  ~itemsPerPage: 10
  ~orderBy: CreatedAt
  ~order: descending
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {
    test('Request is successful', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Search returned both course and learning path enrollments', function () {
        var jsonRes = res.getBody();
  
        expect(jsonRes.Data).to.have.property('CourseEnrollments');
        expect(jsonRes.Data).to.have.property('LearningPathEnrollments');
        
        if (jsonRes.Data.CourseEnrollments) {
            expect(jsonRes.Data.CourseEnrollments).to.have.property('Items');
            expect(jsonRes.Data.CourseEnrollments).to.have.property('TotalCount');
            expect(jsonRes.Data.CourseEnrollments).to.have.property('PageIndex');
            expect(jsonRes.Data.CourseEnrollments).to.have.property('ItemsPerPage');
        }
        
        if (jsonRes.Data.LearningPathEnrollments) {
            expect(jsonRes.Data.LearningPathEnrollments).to.have.property('Items');
            expect(jsonRes.Data.LearningPathEnrollments).to.have.property('TotalCount');
        }
    });
  
    test('Pagination metadata is correct', function () {
        var jsonRes = res.getBody();
        
        if (jsonRes.Data.CourseEnrollments) {
            expect(jsonRes.Data.CourseEnrollments.PageIndex).to.equal(0);
            expect(jsonRes.Data.CourseEnrollments.ItemsPerPage).to.equal(10);
            expect(jsonRes.Data.CourseEnrollments.Items.length).to.be.at.most(10);
        }
    });
}
