meta {
  name: Search Enrollments - Filter by User ID
  type: http
  seq: 13
}

get {
  url: {{BASE_URL}}/enrollments/search?userId={{USER_ID}}&pageIndex=0&itemsPerPage=25
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successful', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Search filtered by user ID returns only that user\'s enrollments', function () {
        var jsonRes = res.getBody();

        if (jsonRes.Data.CourseEnrollments && jsonRes.Data.CourseEnrollments.Items) {
            jsonRes.Data.CourseEnrollments.Items.forEach(function(enrollment) {
                expect(enrollment.UserId).to.equal('{{USER_ID}}');
            });
        }
        
        if (jsonRes.Data.LearningPathEnrollments && jsonRes.Data.LearningPathEnrollments.Items) {
            jsonRes.Data.LearningPathEnrollments.Items.forEach(function(enrollment) {
                expect(enrollment.UserId).to.equal('{{USER_ID}}');
            });
        }
    });
}

