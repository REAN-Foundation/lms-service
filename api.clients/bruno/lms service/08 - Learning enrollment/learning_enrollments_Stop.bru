meta {
  name: Stop Learning enrollment
  type: http
  seq: 6
}

post {
  url: {{BASE_URL}}/learning-enrollments/{{LEARNING_ENROLLMENT_ID}}/stop
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "ProgressStatus": "Completed"
  }
}

tests {

    test('Request is successful', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Learning enrollment stopped', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('IsActive');
        expect(jsonRes.Data.IsActive).to.be.false;
    });
}

