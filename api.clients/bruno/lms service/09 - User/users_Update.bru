meta {
  name: Update User
  type: http
  seq: 4
}

put {
  url: {{BASE_URL}}/user/{{USER_ID}}
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "UserName": "jane.doe",
    "FirstName": "Jane",
    "LastName": "Doe",
    "ProfileImageUrl": "https://example.com/profile/jane.jpg"
  }
}

tests {
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('User updated successfully', function () {
        var jsonRes = res.getBody();
  
        expect(jsonRes.Data).to.have.property('id');
        
        expect(jsonRes.Data).to.have.property('UserName');
        expect(jsonRes.Data).to.have.property('FirstName');
        expect(jsonRes.Data).to.have.property('LastName');
        expect(jsonRes.Data).to.have.property('ProfileImageUrl');
        expect(jsonRes.Data).to.have.property('CreatedAt');
        expect(jsonRes.Data).to.have.property('UpdatedAt');
  
        expect(jsonRes.Data.UserName).equals("jane.doe");
        expect(jsonRes.Data.FirstName).equals("Jane");
        expect(jsonRes.Data.LastName).equals("Doe");
        expect(jsonRes.Data.ProfileImageUrl).equals("https://example.com/profile/jane.jpg");
  
    });
    
}
