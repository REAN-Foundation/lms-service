meta {
  name: Module 1 - Introduction to ML
  type: http
  seq: 5
}

post {
  url: {{BASE_URL}}/course-modules
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "CourseId": "{{COURSE_ID}}",
    "LearningPathId": "{{LEARNING_PATH_ID}}",
    "Name": "Introduction to Machine Learning",
    "Description": "Understanding ML concepts, types, and real-world apps",
    "ImageUrl": "https://images.unsplash.com/photo-1555255707-c07966088b7b",
    "DurationInMins": 120,
    "Sequence": 1
  }
}

script:post-response {
  try {
    var respData = res.getBody();
    bru.setEnvVar('MODULE_1_ID', respData.Data.id);
  }
  catch (error) {
    console.log(error.message);
  }
}

tests {
    try {
        var respData = res.getBody();
        bru.setEnvVar('MODULE_1_ID', respData.Data.id);
    }
    catch (error) {
        console.log(error.message);
    }
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(201);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Module 1 created successfully', function () {
        var jsonRes = res.getBody();
  
        expect(jsonRes.Data).to.have.property('id');
        expect(jsonRes.Data).to.have.property('Name');
        expect(jsonRes.Data.Name).equals("Introduction to Machine Learning");
        expect(jsonRes.Data.Sequence).equals(1);
  
    });
    
}

