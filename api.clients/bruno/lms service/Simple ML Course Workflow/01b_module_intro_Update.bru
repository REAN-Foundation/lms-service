meta {
  name: Update Module 1 - Add Prerequisites
  type: http
  seq: 5.2
}

put {
  url: {{BASE_URL}}/course-modules/{{MODULE_1_ID}}
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "Description": "ML concepts, types, and real-world apps - Updated"
  }
}

tests {
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Module 1 updated successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('id');
        expect(jsonRes.Data.Description).equals("ML concepts, types, and real-world apps - Updated");
    });
}

