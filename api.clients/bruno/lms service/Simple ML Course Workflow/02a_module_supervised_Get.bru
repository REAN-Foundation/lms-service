meta {
  name: Get Module 2 - Supervised Learning
  type: http
  seq: 6.1
}

get {
  url: {{BASE_URL}}/course-modules/{{MODULE_2_ID}}
  body: none
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Module 2 retrieved successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('Name');
        expect(jsonRes.Data.Name).equals("Supervised Learning Algorithms");
        expect(jsonRes.Data.Sequence).equals(2);
    });
}

