meta {
  name: Module 3 - Unsupervised Learning
  type: http
  seq: 10
}

post {
  url: {{BASE_URL}}/course-modules
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "CourseId": "{{COURSE_ID}}",
    "LearningPathId": "{{LEARNING_PATH_ID}}",
    "Name": "Unsupervised Learning & Clustering",
    "Description": "Explore clustering, dimensionality reduction, patterns",
    "ImageUrl": "https://images.unsplash.com/photo-1526628953301-3e589a6a8b74",
    "DurationInMins": 150,
    "Sequence": 3
  }
}

script:post-response {
  try {
    var respData = res.getBody();
    bru.setEnvVar('MODULE_3_ID', respData.Data.id);
  }
  catch (error) {
    console.log(error.message);
  }
}

tests {
    try {
        var respData = res.getBody();
        bru.setEnvVar('MODULE_3_ID', respData.Data.id);
    }
    catch (error) {
        console.log(error.message);
    }
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(201);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Module 3 created successfully', function () {
        var jsonRes = res.getBody();
  
        expect(jsonRes.Data).to.have.property('id');
        expect(jsonRes.Data).to.have.property('Name');
        expect(jsonRes.Data.Name).equals("Unsupervised Learning & Clustering");
        expect(jsonRes.Data.Sequence).equals(3);
  
    });
    
}
