meta {
  name: Content 1.1 - What is Machine Learning?
  type: http
  seq: 12
}

post {
  url: {{BASE_URL}}/course-contents
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "CourseId": "{{COURSE_ID}}",
    "LearningPathId": "{{LEARNING_PATH_ID}}",
    "CourseModuleId": "{{MODULE_1_ID}}",
    "Title": "What is Machine Learning?",
    "Description": "Intro video covering ML fundamentals and importance",
    "ImageUrl": "https://images.unsplash.com/photo-1485827404703-89b55fcc595e",
    "DurationInMins": 15,
    "ContentType": "Video",
    "ResourceLink": "https://www.youtube.com/watch?v=ml-intro-fundamentals",
    "ActionTemplateId": "00000000-0000-0000-0000-000000000000",
    "Sequence": 1
  }
}

script:post-response {
  try {
    var respData = res.getBody();
    bru.setEnvVar('CONTENT_1_1_ID', respData.Data.id);
  }
  catch (error) {
    console.log(error.message);
  }
}

tests {
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(201);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Content created successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('id');
        expect(jsonRes.Data.Title).equals("What is Machine Learning?");
        expect(jsonRes.Data.ContentType).equals("Video");
        expect(jsonRes.Data.Sequence).equals(1);
    });
}
