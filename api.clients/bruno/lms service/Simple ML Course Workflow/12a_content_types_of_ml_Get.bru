meta {
  name: Get Content 1.2 - Types of ML
  type: http
  seq: 16
}

get {
  url: {{BASE_URL}}/course-contents/{{CONTENT_1_2_ID}}
  body: none
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Content 1.2 retrieved successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data.CourseContent).to.have.property('Title');
      expect(jsonRes.Data.CourseContent).to.have.property('Description');
      expect(jsonRes.Data.CourseContent).to.have.property('ImageUrl');
      expect(jsonRes.Data.CourseContent).to.have.property('DurationInMins');
      expect(jsonRes.Data.CourseContent).to.have.property('ContentType');
      expect(jsonRes.Data.CourseContent).to.have.property('ResourceLink');
      expect(jsonRes.Data.CourseContent).to.have.property('ActionTemplateId');
      expect(jsonRes.Data.CourseContent).to.have.property('Sequence');
      expect(jsonRes.Data.CourseContent).to.have.property('CourseId');
      expect(jsonRes.Data.CourseContent).to.have.property('LearningPathId');
      expect(jsonRes.Data.CourseContent).to.have.property('CourseModuleId');
        
    });
}
