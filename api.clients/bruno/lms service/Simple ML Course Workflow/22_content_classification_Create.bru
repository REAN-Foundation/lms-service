meta {
  name: Content 2.2 - Classification Algorithms
  type: http
  seq: 21
}

post {
  url: {{BASE_URL}}/course-contents
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "CourseId": "{{COURSE_ID}}",
    "LearningPathId": "{{LEARNING_PATH_ID}}",
    "CourseModuleId": "{{MODULE_2_ID}}",
    "Title": "Classification Algorithms Guide",
    "Description": "Learn decision trees, random forests, logistic regression",
    "ImageUrl": "https://images.unsplash.com/photo-1509228627152-72ae9ae6848d",
    "DurationInMins": 40,
    "ContentType": "Text",
    "ResourceLink": "https://docs.ml-fundamentals.com/classification",
    "ActionTemplateId": "00000000-0000-0000-0000-000000000000",
    "Sequence": 2
  }
}

script:post-response {
  try {
    var respData = res.getBody();
    bru.setEnvVar('CONTENT_2_2_ID', respData.Data.id);
  }
  catch (error) {
    console.log(error.message);
  }
}

tests {
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(201);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Content created successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('id');
        expect(jsonRes.Data.Title).equals("Classification Algorithms Guide");
        expect(jsonRes.Data.Sequence).equals(2);
    });
}
