meta {
  name: Content 2.3 - Supervised Learning Project
  type: http
  seq: 14
}

post {
  url: {{BASE_URL}}/course-contents
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "CourseId": "{{COURSE_ID}}",
    "LearningPathId": "{{LEARNING_PATH_ID}}",
    "CourseModuleId": "{{MODULE_2_ID}}",
    "Title": "Hands-on Supervised Learning Project",
    "Description": "Build a prediction model using supervised learning",
    "ImageUrl": "https://images.unsplash.com/photo-1460925895917-afdab827c52f",
    "DurationInMins": 60,
    "ContentType": "Project",
    "ResourceLink": "https://lab.ml-fundamentals.com/supervised-project",
    "ActionTemplateId": "00000000-0000-0000-0000-000000000000",
    "Sequence": 3
  }
}

script:post-response {
  try {
    var respData = res.getBody();
    bru.setEnvVar('CONTENT_2_3_ID', respData.Data.id);
  }
  catch (error) {
    console.log(error.message);
  }
}

tests {
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(201);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Content created successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('id');
        expect(jsonRes.Data.Title).equals("Hands-on Supervised Learning Project");
        expect(jsonRes.Data.ContentType).equals("Project");
        expect(jsonRes.Data.Sequence).equals(3);
    });
}

