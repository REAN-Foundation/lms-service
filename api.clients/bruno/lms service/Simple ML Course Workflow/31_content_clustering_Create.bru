meta {
  name: Content 3.1 - K-Means Clustering
  type: http
  seq: 15
}

post {
  url: {{BASE_URL}}/course-contents
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "CourseId": "{{COURSE_ID}}",
    "LearningPathId": "{{LEARNING_PATH_ID}}",
    "CourseModuleId": "{{MODULE_3_ID}}",
    "Title": "K-Means Clustering Algorithm",
    "Description": "Understanding clustering techniques and K-means",
    "ImageUrl": "https://images.unsplash.com/photo-1451187580459-43490279c0fa",
    "DurationInMins": 35,
    "ContentType": "Video",
    "ResourceLink": "https://www.youtube.com/watch?v=kmeans-clustering",
    "ActionTemplateId": "00000000-0000-0000-0000-000000000000",
    "Sequence": 1
  }
}

script:post-response {
  try {
    var respData = res.getBody();
    bru.setEnvVar('CONTENT_3_1_ID', respData.Data.id);
  }
  catch (error) {
    console.log(error.message);
  }
}

tests {
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(201);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Content created successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('id');
        expect(jsonRes.Data.Title).equals("K-Means Clustering Algorithm");
        expect(jsonRes.Data.Sequence).equals(1);
    });
}

