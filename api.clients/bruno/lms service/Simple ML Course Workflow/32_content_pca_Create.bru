meta {
  name: Content 3.2 - Dimensionality Reduction
  type: http
  seq: 25
}

post {
  url: {{BASE_URL}}/course-contents
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "CourseId": "{{COURSE_ID}}",
    "LearningPathId": "{{LEARNING_PATH_ID}}",
    "CourseModuleId": "{{MODULE_3_ID}}",
    "Title": "PCA and Dimensionality Reduction",
    "Description": "Learn PCA and feature extraction techniques",
    "ImageUrl": "https://images.unsplash.com/photo-1518186285589-2f7649de83e0",
    "DurationInMins": 30,
    "ContentType": "Text",
    "ResourceLink": "https://docs.ml-fundamentals.com/pca",
    "ActionTemplateId": "00000000-0000-0000-0000-000000000000",
    "Sequence": 2
  }
}

script:post-response {
  try {
    var respData = res.getBody();
    bru.setEnvVar('CONTENT_3_2_ID', respData.Data.id);
  }
  catch (error) {
    console.log(error.message);
  }
}

tests {
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(201);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Content created successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('id');
        expect(jsonRes.Data.Title).equals("PCA and Dimensionality Reduction");
        expect(jsonRes.Data.Sequence).equals(2);
    });
}
