meta {
  name: Content 3.3 - Anomaly Detection
  type: http
  seq: 26
}

post {
  url: {{BASE_URL}}/course-contents
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "CourseId": "{{COURSE_ID}}",
    "LearningPathId": "{{LEARNING_PATH_ID}}",
    "CourseModuleId": "{{MODULE_3_ID}}",
    "Title": "Anomaly Detection Techniques",
    "Description": "Identify outliers and anomalies using unsupervised methods",
    "ImageUrl": "https://images.unsplash.com/photo-1558494949-ef010cbdcc31",
    "DurationInMins": 35,
    "ContentType": "Assessment",
    "ResourceLink": "https://quiz.ml-fundamentals.com/module-3",
    "ActionTemplateId": "00000000-0000-0000-0000-000000000000",
    "Sequence": 3
  }
}

script:post-response {
  try {
    var respData = res.getBody();
    bru.setEnvVar('CONTENT_3_3_ID', respData.Data.id);
  }
  catch (error) {
    console.log(error.message);
  }
}

tests {
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(201);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Content created successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('id');
        expect(jsonRes.Data.Title).equals("Anomaly Detection Techniques");
        expect(jsonRes.Data.Sequence).equals(3);
    });
}
