meta {
  name: Content 4.3 - Deep Learning Capstone Project
  type: http
  seq: 20
}

post {
  url: {{BASE_URL}}/course-contents
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "CourseId": "{{COURSE_ID}}",
    "LearningPathId": "{{LEARNING_PATH_ID}}",
    "CourseModuleId": "{{MODULE_4_ID}}",
    "Title": "Deep Learning Capstone Project",
    "Description": "Build end-to-end deep learning app with TensorFlow/PyTorch",
    "ImageUrl": "https://images.unsplash.com/photo-1555949963-ff9fe0c870eb",
    "DurationInMins": 90,
    "ContentType": "Project",
    "ResourceLink": "https://lab.ml-fundamentals.com/capstone-project",
    "ActionTemplateId": "00000000-0000-0000-0000-000000000000",
    "Sequence": 3
  }
}

script:post-response {
  try {
    var respData = res.getBody();
    bru.setEnvVar('CONTENT_4_3_ID', respData.Data.id);
  }
  catch (error) {
    console.log(error.message);
  }
}

tests {
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(201);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Content created successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data).to.have.property('id');
        expect(jsonRes.Data.Title).equals("Deep Learning Capstone Project");
        expect(jsonRes.Data.ContentType).equals("Project");
        expect(jsonRes.Data.Sequence).equals(3);
    });
}

