meta {
  name: Get User Learning Progress
  type: http
  seq: 33
}

get {
  url: {{BASE_URL}}/user-learnings/{{USER_LEARNING_ID}}
  body: none
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('User learning retrieved successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data.UserLearning).to.have.property('id');
      
        expect(jsonRes.Data.UserLearning.ProgressStatus).equals("InProgress");
        expect(jsonRes.Data.UserLearning.PercentageCompletion).equals(45);
    });
}
