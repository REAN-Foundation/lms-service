meta {
  name: Update User Learning - Progress to 75%
  type: http
  seq: 21.2
}

put {
  url: {{BASE_URL}}/user-learnings/{{USER_LEARNING_ID}}
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "ProgressStatus": "InProgress",
    "PercentageCompletion": 75
  }
}

tests {
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('User learning updated successfully', function () {
        var jsonRes = res.getBody();
        expect(jsonRes.Data.PercentageCompletion).equals(75);
        expect(jsonRes.Data.ProgressStatus).equals("InProgress");
    });
}

