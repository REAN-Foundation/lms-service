meta {
  name: Post courses
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/courses
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "TenantId": "{{TENANT_ID}}",
    "Name": "Machine Learning Fundamentals",
    "Description": "Learn ML basics, algorithms, and practical applications",
    "ImageUrl": "https://images.unsplash.com/photo-1677442136019-21780ecad995",
    "DurationInDays": 30
  }
}

script:post-response {
  try {
    var respData = res.getBody();
    bru.setEnvVar('COURSE_ID', respData.Data.id);
    bru.setEnvVar('TENANT_ID', respData.Data.TenantId);
  }
  catch (error) {
    console.log(error.message);
  }
}

tests {
    try {
        var respData = res.getBody();
        bru.setEnvVar('COURSE_ID', respData.Data.id);
    }
    catch (error) {
        console.log(error.message);
    }
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(201);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Courses created successfully', function () {
        var jsonRes = res.getBody();
  
        expect(jsonRes.Data).to.have.property('id');
        
        expect(jsonRes.Data).to.have.property('TenantId');
        expect(jsonRes.Data).to.have.property('Name');
        expect(jsonRes.Data).to.have.property('Description');
        expect(jsonRes.Data).to.have.property('ImageUrl');
        expect(jsonRes.Data).to.have.property('DurationInDays');
  
        expect(jsonRes.Data.Name).equals("Machine Learning Fundamentals");
        expect(jsonRes.Data.Description).equals("Learn ML basics, algorithms, and practical applications");
        expect(jsonRes.Data.ImageUrl).equals("https://images.unsplash.com/photo-1677442136019-21780ecad995");
        expect(jsonRes.Data.DurationInDays).equals(30);
  
    });
    
}
