meta {
  name: Post learning_paths
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/learning-paths
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "TenantId": "{{TENANT_ID}}",
    "Name": "AI & Machine Learning Career Track",
    "Description": "Complete path for aspiring ML engineers and data scientists",
    "ImageUrl": "https://images.unsplash.com/photo-1620712943543-bcc4688e7485",
    "DurationInDays": 90,
    "PreferenceWeight": 100,
    "Enabled": true
  }
}

script:post-response {
  try {
    var respData = res.getBody();
    bru.setEnvVar('LEARNING_PATH_ID', respData.Data.id);
    bru.setEnvVar('TENANT_ID', respData.Data.TenantId);
  }
  catch (error) {
    console.log(error.message);
  }
}

tests {
    try {
        var respData = res.getBody();
        bru.setEnvVar('LEARNING_PATH_ID', respData.Data.id);
    }
    catch (error) {
        console.log(error.message);
    }
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(201);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('Learning paths created successfully', function () {
        var jsonRes = res.getBody();
  
        expect(jsonRes.Data).to.have.property('id');
        
        expect(jsonRes.Data).to.have.property('TenantId');
        expect(jsonRes.Data).to.have.property('Name');
        expect(jsonRes.Data).to.have.property('Description');
        expect(jsonRes.Data).to.have.property('ImageUrl');
        expect(jsonRes.Data).to.have.property('DurationInDays');
        expect(jsonRes.Data).to.have.property('PreferenceWeight');
        expect(jsonRes.Data).to.have.property('Enabled');
  
        expect(jsonRes.Data.Name).equals("AI & Machine Learning Career Track");
        expect(jsonRes.Data.Description).equals("Complete path for aspiring ML engineers and data scientists");
        expect(jsonRes.Data.ImageUrl).equals("https://images.unsplash.com/photo-1620712943543-bcc4688e7485");
        expect(jsonRes.Data.DurationInDays).equals(90);
        expect(jsonRes.Data.PreferenceWeight).equals(100);
        expect(jsonRes.Data.Enabled).equals(true);
  
    });
    
}
