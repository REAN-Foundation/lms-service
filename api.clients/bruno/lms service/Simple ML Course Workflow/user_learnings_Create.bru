meta {
  name: Post user_learnings
  type: http
  seq: 21
}

post {
  url: {{BASE_URL}}/user-learnings
  body: json
  auth: none
}

headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

body:json {
  {
    "CourseId": "{{COURSE_ID}}",
    "LearningPathId": "{{LEARNING_PATH_ID}}",
    "CourseModuleId": "{{MODULE_1_ID}}",
    "CourseContentId": "{{CONTENT_1_1_ID}}",
    "UserId": "{{USER_ID}}",
    "ActionId": "00000000-0000-0000-0000-000000000000",
    "ProgressStatus": "InProgress",
    "PercentageCompletion": 45
  }
}

script:pre-request {
  // Set a dummy USER_ID if not already set
  const userId = bru.getEnvVar('USER_ID');
  if (!userId || userId === '') {
    bru.setEnvVar('USER_ID', '3b84ad9e-c5ed-48bc-aa99-af7e624e6445');
    console.log('USER_ID set to default dummy value');
  }
}

script:post-response {
  try {
    var respData = res.getBody();
    bru.setEnvVar('USER_LEARNING_ID', respData.Data.id);
  }
  catch (error) {
    console.log(error.message);
  }
}

tests {
    try {
        var respData = res.getBody();
        bru.setEnvVar('USER_LEARNING_ID', respData.Data.id);
    }
    catch (error) {
        console.log(error.message);
    }
    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(201);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });
  
    test('User learnings created successfully', function () {
        var jsonRes = res.getBody();
  
        expect(jsonRes.Data).to.have.property('id');
        
        expect(jsonRes.Data).to.have.property('CourseId');
        expect(jsonRes.Data).to.have.property('LearningPathId');
        expect(jsonRes.Data).to.have.property('CourseModuleId');
        expect(jsonRes.Data).to.have.property('CourseContentId');
        expect(jsonRes.Data).to.have.property('UserId');
        expect(jsonRes.Data).to.have.property('ActionId');
        expect(jsonRes.Data).to.have.property('ProgressStatus');
        expect(jsonRes.Data).to.have.property('PercentageCompletion');
  
        expect(jsonRes.Data.CourseId).equals('{{COURSE_ID}}');
        expect(jsonRes.Data.LearningPathId).equals('{{LEARNING_PATH_ID}}');
        expect(jsonRes.Data.CourseModuleId).equals('{{MODULE_1_ID}}');
        expect(jsonRes.Data.CourseContentId).equals('{{CONTENT_1_1_ID}}');
        expect(jsonRes.Data.ProgressStatus).equals("InProgress");
        expect(jsonRes.Data.PercentageCompletion).equals(45);
  
    });
    
}
