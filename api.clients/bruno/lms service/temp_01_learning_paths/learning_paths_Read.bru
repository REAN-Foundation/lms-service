
meta {
  name: Get learning_paths
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/learning-paths/{{LEARNING_PATH_ID}}
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Learning paths retrieved successfully', function () {
        var jsonRes = res.getBody();
        
        expect(jsonRes.Data).to.have.property('TenantId');
        expect(jsonRes.Data).to.have.property('Name');
        expect(jsonRes.Data).to.have.property('Description');
        expect(jsonRes.Data).to.have.property('ImageUrl');
        expect(jsonRes.Data).to.have.property('DurationInDays');
        expect(jsonRes.Data).to.have.property('PreferenceWeight');
        expect(jsonRes.Data).to.have.property('Enabled');


    });
    
}
