
meta {
  name: Search learning_paths
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/learning-paths/search?tenantId=db2c751d-d17b-7529-300a-299659984636&name=Repellat id neque.&description=Quia at voluptate.&imageUrl=Consequatur doloremque et.&durationInDays=2816&preferenceWeight=7737&enabled=false
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Learning paths records retrieved successfully', function () {
         var jsonRes = res.getBody();
          expect(jsonRes.Data).to.have.property('Items');
          expect(jsonRes.Data.Items.length).to.be.at.least(0);
    });
    
}
