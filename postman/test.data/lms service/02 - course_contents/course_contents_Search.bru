
meta {
  name: Search course_contents
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/course-contents/search?title=Molestiae vel voluptatem.&description=Quasi laboriosam et.&imageUrl=Error eius molestiae.&durationInMins=2546&contentType=ea&resourceLink=Quia doloremque quas.&actionTemplateId=74925ef7-2a5d-eefd-560c-819f1f587102&sequence=6874
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Course contents records retrieved successfully', function () {
         var jsonRes = res.getBody();
          expect(jsonRes.Data).to.have.property('Items');
          expect(jsonRes.Data.Items.length).to.be.at.least(0);
    });
    
}
