
meta {
  name: Search courses
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/courses/search?tenantId=Recusandae dolorum minus.&name=Minus omnis dolores.&description=Et laboriosam sit.&imageUrl=Rerum voluptate placeat.&durationInDays=7396
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Courses records retrieved successfully', function () {
         var jsonRes = res.getBody();
          expect(jsonRes.Data).to.have.property('Items');
          expect(jsonRes.Data.Items.length).to.be.at.least(0);
    });
    
}
