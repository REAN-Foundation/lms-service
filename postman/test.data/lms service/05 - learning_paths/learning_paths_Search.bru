
meta {
  name: Search learning_paths
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/learning-paths/search?tenantId=9f92abd9-1172-6aa6-496d-1feff62e7357&name=Voluptatem excepturi quo.&description=Debitis et libero.&imageUrl=Maxime omnis natus.&durationInDays=3530&preferenceWeight=8694&enabled=false
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Learning paths records retrieved successfully', function () {
         var jsonRes = res.getBody();
          expect(jsonRes.Data).to.have.property('Items');
          expect(jsonRes.Data.Items.length).to.be.at.least(0);
    });
    
}
