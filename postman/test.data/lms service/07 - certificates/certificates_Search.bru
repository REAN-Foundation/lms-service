
meta {
  name: Search certificates
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/certificates/search?userId=f6265a99-a695-9219-17a1-fffe8eb78824&certificateNumber=Blanditiis et earum.&certificateName=Assumenda eveniet consequuntur.&certificateType=Illum omnis iusto.&issuedDate=Fugit quos quos.&expiryDate=2025-01-15T01:15:48&certificateUrl=Nobis accusamus veritatis.&finalGrade=9299.746&creditHours=5694&skills=Ratione eum omnis.&isVerified=false&verificationUrl=Totam dolorum atque.&issuedBy=fab6378e-97e0-e5e8-bd7f-964904799e0a
  body: json
  auth: none
}


headers {
  x-api-key: {{API_KEY}}
  x-api-secret: {{API_SECRET}}
  content-type: application/json
  Authorization: Bearer {{USER_ACCESS_TOKEN}}
}

tests {

    test('Request is successfully', function () {
        expect(res.getStatus()).to.equal(200);
        var jsonRes = res.getBody();
        expect(jsonRes.Status).to.eql('success');
    });

    test('Certificates records retrieved successfully', function () {
         var jsonRes = res.getBody();
          expect(jsonRes.Data).to.have.property('Items');
          expect(jsonRes.Data.Items.length).to.be.at.least(0);
    });
    
}
