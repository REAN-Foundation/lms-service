{
  "compilerOptions": {
    "target": "ES6",                       
    "module": "CommonJS",                   
    "outDir": "./dist",                    
    "rootDir": "./src",                      
    "esModuleInterop": true,                 
    "strict": true,                          
    "skipLibCheck": true,                     
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "strictPropertyInitialization": false,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",                          
    "dist"
  ]
}